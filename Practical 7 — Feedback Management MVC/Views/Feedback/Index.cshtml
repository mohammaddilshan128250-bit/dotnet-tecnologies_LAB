
@model Practical_07_Feedback_Management_MVC.Models.Feedback

@{
    ViewBag.Title = "Submit Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Submit Feedback</h2>

@using (Html.BeginForm())
{
    <div>
        @Html.LabelFor(model => model.Name)
        <br />
        @Html.TextBoxFor(model => model.Name)
        @Html.ValidationMessageFor(model => model.Name)
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Email)
        <br />
        @Html.TextBoxFor(model => model.Email)
        @Html.ValidationMessageFor(model => model.Email)
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Rating)
        <br />

        @Html.DropDownListFor(
            model => model.Rating,
            new SelectList(new[]
            {
                new { Value = 0, Text = "Select Rating" },
                new { Value = 1, Text = "1 - Poor" },
                new { Value = 2, Text = "2 - Fair" },
                new { Value = 3, Text = "3 - Good" },
                new { Value = 4, Text = "4 - Very Good" },
                new { Value = 5, Text = "5 - Excellent" }
            }, "Value", "Text")
        )

        @Html.ValidationMessageFor(model => model.Rating)
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Comments)
        <br />
        @Html.TextAreaFor(model => model.Comments, 5, 40, null)
        @Html.ValidationMessageFor(model => model.Comments)
    </div>

    <br />

    <button type="submit">Submit Feedback</button>
}
