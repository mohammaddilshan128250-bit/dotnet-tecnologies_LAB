
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Feedback Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #f4f4f4;
        }

        header {
            background-color: #333;
            color: white;
            padding: 20px;
        }

        header h1 {
            margin: 0;
        }

        nav {
            margin-top: 10px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-right: 20px;
        }

        main {
            width: 80%;
            margin: 30px auto;
            background-color: white;
            padding: 25px;
        }

        footer {
            text-align: center;
            padding: 15px;
            color: #666;
        }
    </style>
</head>
<body>
    <header>
        <h1>Feedback Management System</h1>
        <nav>
            @Html.ActionLink("Feedback", "Index", "Feedback")
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>ASP.NET MVC Practical 7</p>
    </footer>
</body>
</html>
